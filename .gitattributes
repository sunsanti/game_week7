# Auto detect text files and perform LF normalization
* text=auto

# Keep Unity YAML text assets with LF and merge=unityyaml if configured
*.cs diff=csharp text
*.cginc text
*.shader text
*.unity text
*.prefab text
*.asset text
*.meta text
*.mat text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.fbx binary
*.blend binary
*.obj binary
*.mp3 binary
*.wav binary
*.ogg binary
*.dll binary
